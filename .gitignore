# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite databases (local only; schema lives in /drizzle)
/data/*.db
/data/*.db-shm
/data/*.db-wal

# test output
/.vitest/

# graphify: commit graph.json + GRAPH_REPORT.md, ignore the rest
/graphify-out/cache/
/graphify-out/manifest.json
/graphify-out/cost.json
/graphify-out/.graphify_python



